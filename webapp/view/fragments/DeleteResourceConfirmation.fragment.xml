<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="DeleteResourceConfirmationDialog"
        title="Delete Confirmation"
        type="Message"
        state="Warning">
        
        <content>
            <Text text="Are you sure you want to delete {/pendingDeleteResourceName}?" class="sapUiSmallMargin" />
        </content>
        
        <beginButton>
            <Button
                text="Yes"
                type="Emphasized"
                press=".onDeleteResourceConfirm" />
        </beginButton>
        
        <endButton>
            <Button
                text="No"
                press=".onDeleteResourceCancel" />
        </endButton>
        
    </Dialog>
</core:FragmentDefinition>
