<mvc:View controllerName="projectmanagement.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    displayBlock="true">
    
    <Page id="page" showHeader="false" class="customPageBackground">
        
        <HBox class="customTopBar" alignItems="Center" justifyContent="SpaceBetween">
            <HBox alignItems="Center">
                <core:Icon src="sap-icon://stack" class="headerIcon sapUiSmallMarginEnd"/>
                <Title text="SAP Fiori Prototype" class="headerTitle"/>
            </HBox>
            <Avatar initials="JD" displaySize="XS" class="headerAvatar" />
        </HBox>

        <HBox class="customSubHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
            <VBox class="sapUiSmallMarginBottom">
                <Title text="Enterprise Project &amp; Resource Management" class="subHeaderTitle"/>
                <Text text="Manage definitions, price profiles, and budget projections." class="subHeaderSubtitle"/>
            </VBox>
            <Button text="+ Allocate Resource" press="onAddAllocation" class="customPrimaryBtn sapUiTinyMarginBottom"/>
        </HBox>

        <VBox class="customContentArea">
            <IconTabBar id="idIconTabBar" class="customTabs" headerBackgroundDesign="Transparent" headerMode="Inline">
                <items>
                    
                    <IconTabFilter text="Projections &amp; Reports" icon="sap-icon://bar-chart">
                        <VBox class="tableWrapper" spacing="Large">
                            
                            <HBox wrap="Wrap" justifyContent="SpaceBetween" class="kpiContainer">
                                <VBox class="kpiCard borderBlue">
                                    <Text text="Total Portfolio Budget" class="kpiTitle"/>
                                    <Title text="{path: '/analytics/summary/totalBudget', formatter: '.formatCurrency'}" class="kpiValue"/>
                                </VBox>
                                <VBox class="kpiCard borderPurple">
                                    <Text text="Total Consumed Cost" class="kpiTitle"/>
                                    <Title text="{path: '/analytics/summary/totalCost', formatter: '.formatCurrency'}" class="kpiValue"/>
                                    <Text text="{path: '/analytics/summary/budgetConsumption', formatter: '.formatDecimal'}% Consumed" class="{= ${/analytics/summary/budgetConsumption} > 100 ? 'kpiSubError' : 'kpiSubText'}" />
                                </VBox>
                                <VBox class="kpiCard borderTeal">
                                    <Text text="Total Resource Capacity" class="kpiTitle"/>
                                    <Title text="{/analytics/summary/totalCapacity} hrs" class="kpiValue"/>
                                </VBox>
                                <VBox class="kpiCard borderOrange">
                                    <Text text="Total Allocated Hours" class="kpiTitle"/>
                                    <Title text="{/analytics/summary/totalAllocatedHours} hrs" class="kpiValue"/>
                                    <Text 
    text="{path: '/analytics/summary/hoursUtilization', formatter: '.formatDecimal'}% Utilized" 
    class="{= ${/analytics/summary/hoursUtilization} > 100 ? 'kpiSubError' : 'kpiSubText'}" />
                                </VBox>
                            </HBox>

                            <HBox class="filterBox" alignItems="End" wrap="Wrap">
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Filter by Project" class="filterLabel"/>
                                    <Select items="{/projects}" selectedKey="{/filters/projectId}" change="onFilterChange" width="200px" forceSelection="false">
                                        <core:Item key="{id}" text="{name}" />
                                    </Select>
                                </VBox>
                                <VBox class="sapUiSmallMarginEnd">
                                    <Label text="Filter by Resource" class="filterLabel"/>
                                    <Select items="{/resources}" selectedKey="{/filters/resourceId}" change="onFilterChange" width="200px" forceSelection="false">
                                        <core:Item key="{id}" text="{name}" />
                                    </Select>
                                </VBox>
                                <Button text="Clear Filters" press="onClearFilters" type="Transparent" class="clearBtn"/>
                            </HBox>

                            <IconTabBar class="innerProjectionsTabs" headerBackgroundDesign="Transparent" headerMode="Inline">
                                <items>

                                    <!-- Sub-Tab 1: Resource Projections -->
                                    <IconTabFilter text="Resource Projections" icon="sap-icon://employee-group">
                                        <Panel backgroundDesign="Solid" class="customPanel">
                                            <headerToolbar>
                                                <Toolbar height="3rem" style="Clear">
                                                    <core:Icon src="sap-icon://employee-group" class="sapUiTinyMarginEnd lightText"/>
                                                    <Title text="Projections by Resource" class="tableTitle"/>
                                                </Toolbar>
                                            </headerToolbar>
                                            <Table items="{/analytics/projectionsByResource}" class="customTable">
                                                <columns>
                                                    <Column><Text text="Name" class="colText"/></Column>
                                                    <Column><Text text="Type" class="colText"/></Column>
                                                    <Column demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Roles" class="colText"/></Column>
                                                    <Column demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Assigned Projects" class="colText"/></Column>
                                                    <Column hAlign="End" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Allocated Time" class="colText"/></Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem vAlign="Middle">
                                                        <cells>
                                                            <VBox><Text text="{name}" class="boldText" /><Text text="{id}" class="lightText"/></VBox>
                                                            <ObjectStatus text="{type}" state="{= ${type} === 'Contract' ? 'Warning' : 'Success'}" inverted="true" class="customStatusPill" />
                                                            <HBox items="{roles}" wrap="Wrap">
                                                                <Text text="{}" class="rolePill sapUiTinyMarginEnd" />
                                                            </HBox>
                                                            <Text text="{projectsAssigned}" class="lightText" />
                                                            <VBox alignItems="End">
                                                                <Text text="{totalHours} hrs / {totalTaskHours} hrs" class="boldText" />
                                                                <Text text="+{extraTaskHours} extra hrs" visible="{= ${extraTaskHours} > 0}" class="textXs textRed" />
                                                            </VBox>
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </Panel>
                                    </IconTabFilter>

                                    <!-- Sub-Tab 2: Projects Projections -->
                                    <IconTabFilter text="Projects Projections" icon="sap-icon://line-chart">
                                        <Panel backgroundDesign="Solid" class="customPanel">
                                            <headerToolbar>
                                                <Toolbar height="3rem" style="Clear">
                                                    <core:Icon src="sap-icon://line-chart" class="sapUiTinyMarginEnd lightText"/>
                                                    <Title text="Projections by Project" class="tableTitle"/>
                                                </Toolbar>
                                            </headerToolbar>
                                            <Table items="{/analytics/projectionsByProject}" class="customTable">
                                                <columns>
                                                    <Column><Text text="Project" class="colText"/></Column>
                                                    <Column demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Active Resources" class="colText"/></Column>
                                                    <Column hAlign="End"><Text text="Allocated Hours" class="colText"/></Column>
                                                    <Column hAlign="End"><Text text="Total Budget" class="colText"/></Column>
                                                    <Column hAlign="End" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Consumed Cost" class="colText"/></Column>
                                                    <Column hAlign="End"><Text text="Remaining" class="colText"/></Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem vAlign="Middle">
                                                        <cells>
                                                            <VBox><Text text="{name}" class="boldText" /><Text text="{id}" class="lightText"/></VBox>
                                                            <Text text="{resourceCount} resources" class="lightText" />
                                                            <Text text="{allocatedPlanHours} hrs" class="boldText" />
                                                            <Text text="{path: 'budget', formatter: '.formatCurrency'}" class="boldText" />
                                                            <Text text="{path: 'allocatedCost', formatter: '.formatCurrency'}" class="lightText" />
                                                            <ObjectStatus text="{path: 'remaining', formatter: '.formatCurrency'}" state="{statusState}" icon="{= ${statusState} === 'Success' ? 'sap-icon://sys-enter-2' : 'sap-icon://alert'}" />
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </Panel>
                                    </IconTabFilter>

                                </items>
                            </IconTabBar>

                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter text="Resources" icon="sap-icon://group">
                        <VBox class="tableWrapper">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="tableHeaderBar">
                                <Title text="Resources &amp; Price Profiles" class="tableTitle"/>
                                <Button text="Add Resource" press="onAddResource" class="customOutlineBtn"/>
                            </HBox>
                            <Table items="{/analytics/enrichedResources}" class="customTable">
                                <columns>
                                    <Column><Text text="Name" class="colText"/></Column>
                                    <Column><Text text="Type" class="colText"/></Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Roles" class="colText"/></Column>
                                    <Column hAlign="End" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Cost Profile / Year" class="colText"/></Column>
                                    <Column hAlign="End"><Text text="Rate" class="colText"/></Column>
                                    <Column hAlign="Center" width="4rem"></Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            <VBox><Text text="{name}" class="boldText"/><Text text="{id}" class="lightText"/></VBox>
                                            <ObjectStatus text="{type}" state="{= ${type} === 'Contract' ? 'Warning' : 'Success'}" inverted="true" class="customStatusPill" />
                                            <HBox items="{roles}" wrap="Wrap">
                                                <Text text="{}" class="rolePill sapUiTinyMarginEnd" />
                                            </HBox>
                                            <VBox alignItems="End">
                                                <Text text="{path: 'salary', formatter: '.formatCurrency'} Base" class="boldText" />
                                                <Text text="+ {parts: [{path: 'officeCost'}, {path: 'overheadCost'}], formatter: 'sap.ui.core.format.NumberFormat.getFloatInstance().format'} Extra" visible="{= ${officeCost} + ${overheadCost} > 0}" class="lightText textXs" />
                                            </VBox>
                                            <Text text="{path: 'hourlyRate', formatter: '.formatCurrency'}/hr" class="customBlueText" />
                                            <HBox justifyContent="Center">
                                                <core:Icon src="sap-icon://edit" class="actionEdit" press="onEditResource" />
                                                <core:Icon src="sap-icon://delete" class="actionDelete sapUiSmallMarginBegin" press="onDeleteResource" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter text="Projects" icon="sap-icon://folder-blank">
                        <VBox class="tableWrapper">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="tableHeaderBar">
                                <Title text="Project Portfolio" class="tableTitle"/>
                                <Button text="Create Project" press="onAddProject" class="customOutlineBtn"/>
                            </HBox>
                            <Table items="{/analytics/enrichedProjects}" class="customTable">
                                <columns>
                                    <Column><Text text="Project ID" class="colText"/></Column>
                                    <Column><Text text="Project Name" class="colText"/></Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Timeline" class="colText"/></Column>
                                    <Column demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline"><Text text="Req. Roles" class="colText"/></Column>
                                    <Column demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline"><Text text="Allocated Resources" class="colText"/></Column>
                                    <!-- <Column demandPopin="true" minScreenWidth="Desktop" popinDisplay="Inline"><Text text="Template" class="colText"/></Column> -->
                                    <Column hAlign="End" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline"><Text text="Actual Costs" class="colText"/></Column>
                                    <Column hAlign="End"><Text text="Budget" class="colText"/></Column>
                                    <Column hAlign="Center" width="4rem"></Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            <Text text="{id}" class="boldText" />
                                            <Text text="{name}" class="lightText"/>
                                            
                                            <VBox>
                                                <Text text="{path: 'startDate', formatter: '.formatDate'} - {path: 'endDate', formatter: '.formatDate'}" class="textXs" />
                                                <Text text="{standardCapacity} std hrs" class="textXs customBlueText sapUiTinyMarginTop" />
                                            </VBox>
                                            <VBox items="{requiredRoles}">
                                                <Text text="• {count}x {role}" class="lightText textXs" />
                                            </VBox>
                                            <VBox items="{assignedResources}">
                                                <HBox class="allocPill sapUiTinyMarginBottom">
                                                    <Text text="{name} - {role} ({hours}h)" class="textXs" />
                                                    <Text text="+{weekendHrs}h wkd" visible="{= ${weekendHrs} > 0}" class="textXs textRed sapUiTinyMarginBegin" />
                                                </HBox>
                                            </VBox>
                                            <!-- <Text text="{templateName}" class="lightText" /> -->
                                            <Text text="{path: 'actualCost', formatter: '.formatCurrency'}" class="customBlueText" />
                                            <Text text="{path: 'budget', formatter: '.formatCurrency'}" class="boldText" />
                                            <HBox justifyContent="Center">
                                                <core:Icon src="sap-icon://edit" class="actionEdit" press="onEditProject" />
                                                <core:Icon src="sap-icon://delete" class="actionDelete sapUiSmallMarginBegin" press="onDeleteProject" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </IconTabFilter>










                    

                    <IconTabFilter text="Project WBS" key="wbs" icon="sap-icon://org-chart">
                        <VBox class="tableWrapper sapUiMediumMarginTop">
                            <VBox class="kpiCard sapUiSmallMarginBottom" style="padding: 1rem;">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" wrap="Wrap">
                                    <VBox width="50%">
                                        <Label text="Select Project for WBS" class="filterLabel" />
                                        <HBox alignItems="Center">
                                            <Select selectedKey="{/wbsSelectedProjectId}" items="{path: '/projects'}" forceSelection="false" change="onWbsProjectChange" width="25rem" class="sapUiTinyMarginEnd forceWhiteSelect">
                                                <core:Item key="{id}" text="{name}" />
                                            </Select>
                    
                                        </HBox>
                                    </VBox>
                                </HBox>

                                <VBox visible="{= !!${/wbsSelectedProjectId} }" class="sapUiMediumMarginTop" style="border-top: 1px solid #e5e7eb; padding-top: 0.5rem;">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" width="100%">
                                        <Title text="Project Plan &amp; Allocations" class="tableTitle sapUiSmallMarginBottom" />
                                        <HBox alignItems="Center" class="sapUiSmallMarginBottom" wrap="Wrap">
                                            <Button text="+ Add Task" press="onAddWbsTask" class="customPrimaryBtn" />
                                        </HBox>
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- WBS Tasks Table -->
                            <VBox visible="{= !!${/wbsSelectedProjectId} &amp;&amp; ${/wbsTasksForSelectedProject}.length > 0 }" class="customPanel" style="overflow-x: auto;">
                                <Table items="{/wbsTasksForSelectedProject}" class="customTable" mode="None">
                                    <columns>
                                        <Column width="2rem" hAlign="Center"><Text text="#" class="colText"/></Column>
                                        <Column width="10rem"><Text text="Phase / Criticality" class="colText"/></Column>
                                        <Column width="10rem"><Text text="Task Name" class="colText"/></Column>
                                        <Column width="4rem" hAlign="Center"><Text text="Hrs" class="colText"/></Column>
                                        <Column width="11rem"><Text text="Predecessor" class="colText"/></Column>
                                        <Column width="9rem"><Text text="Start Date" class="colText"/></Column>
                                        <Column width="9rem"><Text text="End Date" class="colText"/></Column>
                                        <Column width="14rem"><Text text="Resource" class="colText"/></Column>
                                        <Column width="3rem" hAlign="Center"><Text text="" class="colText"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem vAlign="Middle" type="Inactive" class="hoverableRow">
                                            <cells>
                                                <Text text="{index}" class="textXs lightText" />
                                                <Input value="{phaseName}" class="transparentInput boldText" width="100%" change="onUpdateWbsTask" />
                                                <Input value="{name}" class="transparentInput" width="100%" change="onUpdateWbsTask" />
                                                <Input value="{hours}" type="Number" class="customInput textAlignCenter" width="100%" change="onUpdateWbsTaskHours" />
                                                <Input value="{predecessor}" type="Number" placeholder="" class="customInput textAlignCenter" width="100%" change="onUpdateWbsTaskPredecessor" />
                                                <Input value="{startDateEdit}" type="Date" placeholder="YYYY-MM-DD" class="customInput textXsInput" width="100%" editable="false"/>
                                                <Input value="{endDateEdit}" type="Date" placeholder="YYYY-MM-DD" class="customInput textXsInput" width="100%" editable="false"/>
                                                <Select selectedKey="{resourceId}" items="{path: '/resources'}" forceSelection="false" width="100%" class="forceWhiteSelect" change="onUpdateWbsTaskResource">
                                                    <core:Item key="{id}" text="{name}" />
                                                </Select>
                                                <Button icon="sap-icon://decline" press="onRemoveWbsTask" type="Transparent" class="deleteIconHover" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>

                            <!-- Empty WBS State -->
                            <VBox visible="{= !!${/wbsSelectedProjectId} &amp;&amp; ${/wbsTasksForSelectedProject}.length === 0 }" class="kpiCard" style="background-color: #f9fafb; padding: 2rem; align-items: center; justify-content: center; min-height: 200px;">
                                <core:Icon src="sap-icon://hierarchy" size="3rem" color="#d1d5db" class="sapUiSmallMarginBottom" />
                                <Text text="No Work Breakdown Structure defined yet." class="boldText" />
                                <Text text="Start adding tasks manually or select a template when creating a project." class="lightText textXs sapUiTinyMarginTop" />
                            </VBox>

                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter text="Timeline" key="timeline" icon="sap-icon://calendar">
                        <VBox class="tableWrapper sapUiMediumMarginTop">
                            <VBox class="kpiCard sapUiSmallMarginBottom" style="padding: 1.5rem 1.5rem 0 1.5rem; border-radius: 6px;">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                                    <VBox width="20rem">
                                        <Label text="Select Project Timeline" class="filterLabel textXs sapUiTinyMarginBottom" />
                                        <Select selectedKey="{/timelineSelectedProjectId}" items="{path: '/projects'}" forceSelection="false" change="onTimelineProjectChange" width="100%" class="forceWhiteSelect">
                                            <core:Item key="{id}" text="{name}" />
                                        </Select>
                                    </VBox>
                                </HBox>

                                <VBox visible="{= !!${/timelineSelectedProjectId} }" style="margin-top: 2rem;">
                                    <IconTabBar selectedKey="{/timelineActiveSection}" headerBackgroundDesign="Transparent" headerMode="Inline" class="innerProjectionsTabs" expandable="false" expanded="true">
                                        <items>
                                            <IconTabFilter text="Task Level Timeline" key="tasks" icon="sap-icon://menu2" />
                                            <IconTabFilter text="Resource Allocation Timeline" key="resources" icon="sap-icon://group" />
                                        </items>
                                    </IconTabBar>
                                </VBox>
                            </VBox>

                            <VBox visible="{= !!${/timelineData} &amp;&amp; ${/timelineData/tasks}.length > 0 }" class="timelineChartContainer">
                                
                                <!-- Header Row with Weeks and Days -->
                                <HBox class="timelineHeaderRow">
                                    <VBox class="timelineLabelCol timelineHeaderLabelCol">
                                        <Text text="{= ${/timelineActiveSection} === 'tasks' ? 'Tasks &amp; Timeline' : 'Resources &amp; Allocations' }" class="boldText" style="font-size: 0.875rem; color: #374151;" />
                                    </VBox>
                                    
                                    <!-- Dynamic weeks/days header -->
                                    <HBox items="{/timelineData/weeks}" class="timelineGridArea" style="min-width: {/timelineData/gridMinWidth}">
                                        <VBox class="timelineWeekCol">
                                            <layoutData>
                                                <FlexItemData growFactor="{daysCount}" shrinkFactor="0" baseSize="0%" />
                                            </layoutData>
                                            <VBox class="timelineWeekLabel">
                                                <Text text="{label}" class="timelineWeekLabelText" />
                                            </VBox>
                                            <HBox items="{days}" class="timelineDaysRow">
                                                <VBox class="{= ${isWeekend} ? 'timelineDayCell timelineDayCellWeekend' : 'timelineDayCell'}">
                                                    <Text text="{label}" class="timelineDayText" tooltip="{fullDate}" />
                                                </VBox>
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                </HBox>

                                <!-- Body Rows -->
                                <VBox class="timelineBody">
                                    
                                    <!-- Tasks View -->
                                    <VBox items="{/timelineData/tasks}" visible="{= ${/timelineActiveSection} === 'tasks' }">
                                        <HBox class="timelineTaskRow">
                                            <VBox class="timelineLabelCol timelineTaskLabelCol">
                                                <Text text="{name}" class="boldText" style="font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" tooltip="{name}" />
                                                <Text text="{resourceName} ({hours}h)" class="lightText textXs" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px;" tooltip="{resourceName}" />
                                            </VBox>
                                            
                                            <HBox class="timelineGridArea timelineBarArea" style="min-width: {/timelineData/gridMinWidth}">
                                                <HBox class="timelineGridOverlay" items="{/timelineData/weeks}">
                                                    <HBox class="timelineWeekGridCol" items="{days}">
                                                        <layoutData>
                                                            <FlexItemData growFactor="{daysCount}" shrinkFactor="0" baseSize="0%" />
                                                        </layoutData>
                                                        <VBox class="{= ${isWeekend} ? 'timelineDayGridCell timelineDayGridWeekend' : 'timelineDayGridCell'}"></VBox>
                                                    </HBox>
                                                </HBox>
                                                
                                                <!-- Bar -->
                                                <HBox class="ganttTaskBarWrapper">
                                                    <VBox class="ganttBarSpacer" width="{leftPx}px"></VBox>
                                                    <VBox class="ganttBarTask" width="{widthPx}px" tooltip="Start: {startDate}&#10;End: {endDate}">
                                                        <Text text="{name}" class="ganttBarText" />
                                                    </VBox>
                                                </HBox>
                                            </HBox>
                                        </HBox>
                                    </VBox>

                                    <!-- Resources View -->
                                    <VBox items="{/timelineResourceData}" visible="{= ${/timelineActiveSection} === 'resources' }">
                                        <HBox class="timelineTaskRow">
                                            <VBox class="timelineLabelCol timelineTaskLabelCol">
                                                <Text text="{resourceName}" class="boldText" style="font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" tooltip="{resourceName}" />
                                                <Text text="{totalHours}h Total Allocated" class="lightText textXs" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px;" />
                                            </VBox>
                                            
                                            <!-- Dynamic Height based on tasks -->
                                            <HBox class="timelineGridArea timelineBarArea dynamicResourcRow" style="min-width: {/timelineData/gridMinWidth}">
                                                <customData>
                                                    <core:CustomData key="heightPx" value="{heightPx}" writeToDom="true" />
                                                </customData>
                                                <!-- Background Grid -->
                                                <HBox class="timelineGridOverlay" items="{/timelineData/weeks}">
                                                    <HBox class="timelineWeekGridCol" items="{days}">
                                                        <layoutData>
                                                            <FlexItemData growFactor="{daysCount}" shrinkFactor="0" baseSize="0%" />
                                                        </layoutData>
                                                        <VBox class="{= ${isWeekend} ? 'timelineDayGridCell timelineDayGridWeekend' : 'timelineDayGridCell'}"></VBox>
                                                    </HBox>
                                                </HBox>
                                                
                                                <VBox items="{tasks}" class="ganttResourceBarsWrapper">
                                                    <HBox class="ganttResourceBarRow">
                                                        <VBox class="ganttBarSpacer" width="{leftPx}px"></VBox>
                                                        <VBox class="ganttBarResource" width="{widthPx}px" tooltip="Task: {name}&#10;Start: {startDate}&#10;End: {endDate}&#10;Hours: {hours}">
                                                            <Text text="{name}" class="ganttBarText" />
                                                        </VBox>
                                                    </HBox>
                                                </VBox>
                                            </HBox>
                                        </HBox>
                                    </VBox>

                                </VBox>
                            </VBox>

                            <VBox visible="{= !!${/timelineSelectedProjectId} &amp;&amp; (!${/timelineData} || !${/timelineData/tasks} || ${/timelineData/tasks}.length === 0) }" style="text-align: center; padding: 2rem 1rem; border: 1px solid #e5e7eb; border-radius: 6px; background-color: #f9fafb;">
                                <core:Icon src="sap-icon://calendar" size="2.5rem" color="#d1d5db" class="sapUiSmallMarginBottom" />
                                <Text text="No tasks allocated to WBS for this project." class="boldText" />
                                <Text text="Add tasks in the Project WBS tab to see the timeline." class="lightText textXs sapUiTinyMarginTop" />
                            </VBox>

                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter text="Employees" key="employees" icon="sap-icon://employee">
                        <VBox class="tableWrapper sapUiMediumMarginTop">
                            <VBox class="kpiCard sapUiSmallMarginBottom" style="padding: 1rem;">
                                <VBox width="50%">
                                    <Label text="Select Resource" class="filterLabel" />
                                    <Select selectedKey="{/employeeSelectedResourceId}" items="{path: '/resources'}" forceSelection="false" change="onEmployeeResourceChange" width="25rem" class="forceWhiteSelect">
                                        <core:Item key="{id}" text="{name}" />
                                    </Select>
                                </VBox>
                            </VBox>

                            <!-- KPI Summary Cards (above tasks table) -->
                            <VBox visible="{= !!${/employeeSelectedResourceId} &amp;&amp; ${/employeeTasks}.length > 0 &amp;&amp; !!${/employeeTimeSummary} }">
                                <HBox wrap="Wrap" justifyContent="SpaceBetween" class="kpiContainer sapUiSmallMarginBottom">
                                    <VBox class="kpiCard borderBlue">
                                        <Text text="Total Planned Hours" class="kpiTitle"/>
                                        <Title text="{/employeeTimeSummary/totalPlannedHours} hrs" class="kpiValue"/>
                                    </VBox>
                                    <VBox class="kpiCard borderPurple">
                                        <Text text="Total Time Worked" class="kpiTitle"/>
                                        <Title text="{/employeeTimeSummary/totalWorkedDisplay}" class="kpiValue"/>
                                    </VBox>
                                    <VBox class="kpiCard borderTeal">
                                        <Text text="Completion Rate" class="kpiTitle"/>
                                        <Title text="{/employeeTimeSummary/completionPercent}%" class="kpiValue"/>
                                        <Text text="{/employeeTimeSummary/completedCount} of {/employeeTimeSummary/totalCount} tasks" class="kpiSubText"/>
                                    </VBox>
                                    <VBox class="kpiCard borderOrange">
                                        <Text text="Active Tasks" class="kpiTitle"/>
                                        <Title text="{/employeeTimeSummary/inProgressCount}" class="kpiValue"/>
                                        <Text text="Currently In Progress" class="kpiSubText"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <!-- Employee Tasks Table -->
                            <VBox visible="{= !!${/employeeSelectedResourceId} &amp;&amp; ${/employeeTasks}.length > 0 }" class="customPanel" style="overflow-x: auto;">
                                <Panel backgroundDesign="Solid" class="customPanel">
                                    <headerToolbar>
                                        <Toolbar height="3rem" style="Clear">
                                            <core:Icon src="sap-icon://task" class="sapUiTinyMarginEnd lightText"/>
                                            <Title text="Assigned Tasks" class="tableTitle"/>
                                        </Toolbar>
                                    </headerToolbar>
                                    <Table items="{/employeeTasks}" class="customTable" mode="None">
                                        <columns>
                                            <Column><Text text="Project" class="colText"/></Column>
                                            <Column><Text text="Phase" class="colText"/></Column>
                                            <Column><Text text="Task" class="colText"/></Column>
                                            <Column hAlign="Center" width="5rem"><Text text="Planned" class="colText"/></Column>
                                            <Column hAlign="Center" width="7rem"><Text text="Time Worked" class="colText"/></Column>
                                            <Column hAlign="Center" width="5rem"><Text text="Progress" class="colText"/></Column>
                                            <Column hAlign="Center"><Text text="Status" class="colText"/></Column>
                                            <Column hAlign="Center" width="10rem"><Text text="Actions" class="colText"/></Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem vAlign="Middle" class="hoverableRow">
                                                <cells>
                                                    <VBox>
                                                        <Text text="{projectName}" class="boldText" />
                                                        <Text text="{path: 'startDate', formatter: '.formatDate'} - {path: 'endDate', formatter: '.formatDate'}" class="textXs lightText" />
                                                    </VBox>
                                                    <Text text="{phaseName}" class="lightText" />
                                                    <Text text="{name}" class="boldText" />
                                                    <Text text="{hours} hrs" class="boldText" />
                                                    <VBox alignItems="Center">
                                                        <Text text="{elapsedDisplay}" class="{= ${isOvertime} ? 'boldText textRed' : 'boldText customBlueText'}" />
                                                        <Text text="{= ${isOvertime} ? 'Overtime' : ''}" visible="{isOvertime}" class="textXs textRed" />
                                                    </VBox>
                                                    <Text text="{progressPercent}%" class="{= ${progressPercent} >= 100 ? 'boldText textRed' : 'boldText'}" />
                                                    <ObjectStatus text="{status}" state="{= ${status} === 'Completed' ? 'Success' : (${status} === 'In Progress' ? 'Warning' : (${status} === 'Paused' ? 'Information' : 'None'))}" inverted="true" class="customStatusPill" />
                                                    <HBox justifyContent="Center" alignItems="Center">
                                                        <Button icon="sap-icon://begin" tooltip="Start" press="onEmployeeTaskStart" type="Accept" enabled="{= ${status} !== 'In Progress' &amp;&amp; ${status} !== 'Completed'}" class="sapUiTinyMarginEnd" />
                                                        <Button icon="sap-icon://pause" tooltip="Pause" press="onEmployeeTaskPause" type="Attention" enabled="{= ${status} === 'In Progress'}" class="sapUiTinyMarginEnd" />
                                                        <Button icon="sap-icon://stop" tooltip="Stop / Complete" press="onEmployeeTaskStop" type="Reject" enabled="{= ${status} !== 'Completed' &amp;&amp; ${status} !== 'Not Started'}" />
                                                    </HBox>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </Panel>
                            </VBox>

                            <!-- Task Time Log (per-task breakdown) -->
                            <VBox visible="{= !!${/employeeSelectedResourceId} &amp;&amp; ${/employeeTasks}.length > 0 }" class="sapUiSmallMarginTop">
                                <Panel backgroundDesign="Solid" class="customPanel">
                                    <headerToolbar>
                                        <Toolbar height="3rem" style="Clear">
                                            <core:Icon src="sap-icon://time-entry-request" class="sapUiTinyMarginEnd lightText"/>
                                            <Title text="Task Time Log" class="tableTitle"/>
                                        </Toolbar>
                                    </headerToolbar>
                                    <List items="{/employeeTasks}" class="customTable" showSeparators="Inner">
                                        <CustomListItem class="hoverableRow">
                                            <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%" style="padding: 0.75rem 1rem;">
                                                <VBox width="35%">
                                                    <Text text="{name}" class="boldText" />
                                                    <Text text="{projectName} · {phaseName}" class="lightText textXs" />
                                                </VBox>
                                                <VBox alignItems="Center" width="15%">
                                                    <Text text="Planned" class="lightText textXs" />
                                                    <Text text="{hours} hrs" class="boldText" />
                                                </VBox>
                                                <VBox alignItems="Center" width="15%">
                                                    <Text text="Worked" class="lightText textXs" />
                                                    <Text text="{elapsedDisplay}" class="{= ${isOvertime} ? 'boldText textRed' : 'boldText customBlueText'}" />
                                                </VBox>
                                                <VBox width="25%" class="sapUiTinyMarginBegin">
                                                    <HBox justifyContent="SpaceBetween" width="100%">
                                                        <Text text="{progressPercent}%" class="textXs boldText" />
                                                        <ObjectStatus text="{status}" state="{= ${status} === 'Completed' ? 'Success' : (${status} === 'In Progress' ? 'Warning' : (${status} === 'Paused' ? 'Information' : 'None'))}" inverted="true" class="customStatusPill" />
                                                    </HBox>
                                                    <ProgressIndicator percentValue="{progressPercent}" displayValue="{elapsedDisplay} / {hours} hrs" state="{= ${progressPercent} >= 100 ? 'Error' : (${progressPercent} >= 75 ? 'Warning' : 'Success')}" class="sapUiTinyMarginTop" height="1.25rem" />
                                                </VBox>
                                            </HBox>
                                        </CustomListItem>
                                    </List>
                                </Panel>
                            </VBox>

                            <!-- Empty State -->
                            <VBox visible="{= !!${/employeeSelectedResourceId} &amp;&amp; ${/employeeTasks}.length === 0 }" class="kpiCard" style="background-color: #f9fafb; padding: 2rem; align-items: center; justify-content: center; min-height: 200px;">
                                <core:Icon src="sap-icon://task" size="3rem" color="#d1d5db" class="sapUiSmallMarginBottom" />
                                <Text text="No tasks assigned to this resource." class="boldText" />
                                <Text text="Assign tasks in the Project WBS tab." class="lightText textXs sapUiTinyMarginTop" />
                            </VBox>

                        </VBox>
                    </IconTabFilter>

                </items>
            </IconTabBar>
        </VBox>
    </Page>
</mvc:View>